# Public values are inlined at BUILD time: in Easypanel set them as Build Arguments, not only runtime env.
NEXT_PUBLIC_SITE_URL=https://vitalizemaroc.shop
NEXT_PUBLIC_API_BASE_URL=https://api.vitalizemaroc.shop

# Public pixel ids only. Leave blank to disable a platform.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# true (default): show the consent banner and load pixels only after "accept".
# false: pixels load for everyone. Only set after legal review of your obligations in Morocco.
NEXT_PUBLIC_REQUIRE_TRACKING_CONSENT=true

# Real support WhatsApp number (06/07xxxxxxxx or +212...). Leave blank to hide all WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=
