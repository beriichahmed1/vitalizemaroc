APP_ENV=production
API_PUBLIC_BASE_URL=https://api.vitalizemaroc.shop
SITE_PUBLIC_URL=https://vitalizemaroc.shop
FRONTEND_ORIGINS=https://vitalizemaroc.shop

# Paste the Easypanel internal URL here as-is (postgres://user:pass@host:5432/db?sslmode=disable).
# The app rewrites the scheme to postgresql+psycopg automatically. Never commit the real value.
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/vitalizemaroc?sslmode=disable

# At least 32 random characters each (e.g. `openssl rand -hex 32`).
ORDER_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_32_CHARS_OR_MORE
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_32_CHARS_OR_MORE

# Required before orders are accepted. 0 = free delivery (approved by the owner: prices are all-inclusive).
DELIVERY_FEE_MAD=0
UPSELL_SECONDS=15

# true: the API process also runs the Sheets/CAPI/upsell-expiry worker (simplest on Easypanel).
# false: run a second service with the container argument `worker` instead.
RUN_WORKER_IN_API=true
# Number of reverse proxies in front of the API (Easypanel/Traefik = 1); used to read the client IP.
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO

# Conversion APIs: leave blank until the platform + consent setup is approved.
# Events are only sent for visitors who accepted tracking, and only when both id and token are set.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
SNAP_PIXEL_ID=
SNAP_CAPI_ACCESS_TOKEN=
# true: send to Snap's /events/validate endpoint (no real events) while testing.
SNAP_CAPI_VALIDATE_ONLY=false
